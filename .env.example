# GEMINI_API_KEY: Required for server-side Gemini 4 Hydrogen intent parsing (/api/intent).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Required for server-side ElevenLabs STT (scribe_v2 via /api/stt)
# and low-latency Indonesian TTS (eleven_flash_v2_5 via /api/tts).
# Never expose this key to the React Native / Android bundle.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: Optional ElevenLabs voice ID for Indonesian narration.
# Defaults to Rachel (21m00Tcm4TlvDq8ikWAM) when omitted.
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# APP_URL: The URL where this applet / voice proxy is hosted.
APP_URL="MY_APP_URL"
