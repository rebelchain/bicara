# GEMINI_API_KEY: Required for server-side Gemini 4 Hydrogen intent parsing (/api/intent).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Required for server-side ElevenLabs STT (scribe_v2 via /api/stt)
# and low-latency English TTS (eleven_flash_v2_5 via /api/tts).
# Never expose this key to the React Native / Android bundle.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: Optional ElevenLabs voice ID for spoken TxSummary narration.
# Defaults to Sarah (EXAVITQu4vr4xnSDxMaL, premade free-tier compatible) when omitted.
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"

# JUPITER_API_KEY: Required for server-side Quote-Only Jupiter Swap API V2 (/api/swap/quote)
# and optional higher rate limits on Jupiter Price API V3 (/api/prices).
# Never expose this key to the React Native / Android bundle.
JUPITER_API_KEY="JUPITER_API_KEY"

# APP_URL: The URL where this applet / voice proxy is hosted.
APP_URL="MY_APP_URL"
