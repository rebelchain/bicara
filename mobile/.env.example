# URL backend Next.js Voice Proxy (/api/health, /api/stt, /api/intent, /api/tts).
# Saat HP Android dicolok USB + `adb reverse tcp:3000 tcp:3000`, cukup pakai http://localhost:3000.
# Saat demo panggung tanpa kabel USB, ganti ke URL server publik atau IP LAN laptop.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Solana Devnet RPC Endpoint (Track A @solana/kit)
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_CHAIN=solana:devnet

# Step 2: Supabase (Contacts & Transaction History)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Step 3: Picovoice Eagle On-Device Voiceprint AccessKey
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=YOUR_PICOVOICE_ACCESS_KEY
