# Next.js Voice Proxy URL (/api/health, /api/stt, /api/intent, /api/tts, /api/swap/quote, /api/prices)
# Over USB with `adb reverse tcp:3000 tcp:3000`, keep http://localhost:3000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Solana Devnet RPC Endpoint (Track A @solana/kit — Devnet Only)
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_CHAIN=solana:devnet

# Gate B: Supabase (Verified Contacts & Devnet Transaction History)
# Only public URL + public anon key belong here. Never put service_role keys in mobile/.env.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional Layer 1: Picovoice Eagle On-Device Voiceprint AccessKey (deferred post-Gate B)
EXPO_PUBLIC_PICOVOICE_ACCESS_KEY=YOUR_PICOVOICE_ACCESS_KEY
