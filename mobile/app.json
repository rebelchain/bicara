{
  "expo": {
    "name": "Bicara",
    "slug": "bicara-mobile",
    "version": "0.1.0",
    "scheme": "bicara",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D0E",
    "newArchEnabled": true,
    "android": {
      "package": "xyz.dev3pack.bicara",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D0E"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Bicara membutuhkan akses mikrofon agar kamu dapat menavigasi menu dan mengirim USDC hanya dengan suara.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
